<Window x:Class="IvanovKursovaya.View.Windows.EditBookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IvanovKursovaya.View.Windows"
        mc:Ignorable="d"
        Title="Изменение записи"
        Height="600"
        Width="850"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>

        <Border Margin="25"
                Background="White"
                CornerRadius="25">

            <Grid Margin="30">

                <!-- Колонки -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Строки -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Text="Изменение записи"
                           Grid.ColumnSpan="3"
                           FontSize="28"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <!-- Дата -->
                <TextBlock Text="Дата тренировки:"
                           Grid.Row="2"
                           Grid.Column="0"
                           FontSize="16"
                           VerticalAlignment="Center"/>

                <DatePicker x:Name="DataDP"
                            Grid.Row="2"
                            Grid.Column="2"
                            FontSize="16"/>

                <!-- Тренировка -->
                <TextBlock Text="Название тренировки:"
                           Grid.Row="4"
                           Grid.Column="0"
                           FontSize="16"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="TrainingTitle"
                          Grid.Row="4"
                          Grid.Column="2"
                          FontSize="16"
                          Padding="5"
                          DisplayMemberPath="Title"
                          SelectedValuePath="Id"
                          SelectionChanged="TrainingTitle_SelectionChanged"/>

                <!-- Клиент -->
                <TextBlock Text="Имя клиента:"
                           Grid.Row="6"
                           Grid.Column="0"
                           FontSize="16"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="Client"
                          Grid.Row="6"
                          Grid.Column="2"
                          FontSize="16"
                          Padding="5"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectionChanged="Client_SelectionChanged"/>

                <!-- Инструктор -->
                <TextBlock Text="Имя инструктора:"
                           Grid.Row="8"
                           Grid.Column="0"
                           FontSize="16"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="DogHandler"
                          Grid.Row="8"
                          Grid.Column="2"
                          FontSize="16"
                          Padding="5"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectionChanged="DogHandler_SelectionChanged"/>

                <!-- Кнопки -->
                <Grid Grid.Row="10"
                      Grid.ColumnSpan="3">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Сохранить -->
                    <Button x:Name="SaveBtn"
                            Grid.Column="0"
                            Content="Сохранить"
                            Height="45"
                            FontSize="16"
                            Background="#F26A1B"
                            Foreground="White"
                            BorderThickness="0"
                            Click="SaveBtn_Click"/>

                    <!-- Закрыть -->
                    <Button x:Name="CloseBtn"
                            Grid.Column="2"
                            Content="Закрыть"
                            Height="45"
                            FontSize="16"
                            Background="#222222"
                            Foreground="White"
                            BorderThickness="0"
                            Click="CloseBtn_Click"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>
</Window>