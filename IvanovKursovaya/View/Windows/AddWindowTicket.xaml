<Window x:Class="IvanovKursovaya.View.Windows.AddWindowTicket"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IvanovKursovaya.View.Windows"
        mc:Ignorable="d"
         Title="Запись на тренировку"
        Height="520"
        Width="850"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>

        <Border Margin="25"
                Background="White"
                CornerRadius="25">

            <Grid Margin="30">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="55"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Добавление записи"
                           Grid.ColumnSpan="2"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Дата тренировки"
                           Grid.Row="2"
                           VerticalAlignment="Center"
                           FontSize="16"/>

                <DatePicker x:Name="DataDP"
                            Grid.Row="2"
                            Grid.Column="1"
                            FontSize="16"/>

                <TextBlock Text="Название тренировки"
                           Grid.Row="4"
                           VerticalAlignment="Center"
                           FontSize="16"/>

                <ComboBox x:Name="TrainingTitle"
                          Grid.Row="4"
                          Grid.Column="1"
                          FontSize="16"
                          DisplayMemberPath="Title"
                          SelectedValuePath="Id"
                          SelectionChanged="TrainingTitle_SelectionChanged"/>

                <TextBlock Text="Клиент"
                           Grid.Row="6"
                           VerticalAlignment="Center"
                           FontSize="16"/>

                <ComboBox x:Name="Client"
                          Grid.Row="6"
                          Grid.Column="1"
                          FontSize="16"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectionChanged="Client_SelectionChanged"/>

                <TextBlock Text="Инструктор"
                           Grid.Row="8"
                           VerticalAlignment="Center"
                           FontSize="16"/>

                <ComboBox x:Name="DogHandler"
                          Grid.Row="8"
                          Grid.Column="1"
                          FontSize="16"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectionChanged="DogHandler_SelectionChanged"/>

                <Button x:Name="SaveBtn"
                        Grid.Row="10"
                        Content="Сохранить"
                        Height="45"
                        Margin="0,0,10,0"
                        Background="#F26A1B"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Click="SaveBtn_Click"/>

                <Button x:Name="CloseBtn"
                        Grid.Row="10"
                        Grid.Column="1"
                        Content="Закрыть"
                        Height="45"
                        Margin="10,0,0,0"
                        Background="#222222"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Click="CloseBtn_Click"/>

            </Grid>

        </Border>

    </Grid>
</Window>