<Window x:Class="IvanovKursovaya.View.Windows.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IvanovKursovaya.View.Windows"
        mc:Ignorable="d"
 Title="Регистрация"
        Height="720"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Лого -->
        <Grid Background="White">
            <Image Source="/Images/кинолог.png"
                   Width="450"
                   Height="450"
                   Stretch="Uniform"/>
        </Grid>

        <!-- Форма -->
        <Border Grid.Column="1"
                Margin="30"
                Background="White"
                CornerRadius="25">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <Grid Margin="40">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Создание аккаунта"
                               Grid.ColumnSpan="2"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="Логин"
                               Grid.Row="1"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="LoginTB"
                             Grid.Row="1"
                             Grid.Column="1"
                             FontSize="16"
                             Padding="12"
                             BorderBrush="#F26A1B"
                             BorderThickness="2"/>

                    <TextBlock Text="Имя"
                               Grid.Row="3"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="NameTB"
                             Grid.Row="3"
                             Grid.Column="1"
                             FontSize="16"
                             Padding="12"
                             BorderBrush="#F26A1B"
                             BorderThickness="2"/>

                    <TextBlock Text="Фамилия"
                               Grid.Row="5"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="SurenameTB"
                             Grid.Row="5"
                             Grid.Column="1"
                             FontSize="16"
                             Padding="12"
                             BorderBrush="#F26A1B"
                             BorderThickness="2"/>

                    <TextBlock Text="Отчество"
                               Grid.Row="7"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="PatronymicTB"
                             Grid.Row="7"
                             Grid.Column="1"
                             FontSize="16"
                             Padding="12"
                             BorderBrush="#F26A1B"
                             BorderThickness="2"/>

                    <TextBlock Text="Телефон"
                               Grid.Row="9"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="PhoneTB"
                             Grid.Row="9"
                             Grid.Column="1"
                             FontSize="16"
                             Padding="12"
                             BorderBrush="#F26A1B"
                             BorderThickness="2"/>

                    <TextBlock Text="Электронная почта"
                               Grid.Row="11"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="EmailTB"
                             Grid.Row="11"
                             Grid.Column="1"
                             FontSize="16"
                             Padding="12"
                             BorderBrush="#F26A1B"
                             BorderThickness="2"/>

                    <TextBlock Text="Пароль"
                               Grid.Row="13"
                               VerticalAlignment="Center"/>

                    <PasswordBox x:Name="PassFstPB"
                                 Grid.Row="13"
                                 Grid.Column="1"
                                 FontSize="16"
                                 Padding="12"
                                 BorderBrush="#F26A1B"
                                 BorderThickness="2"/>

                    <TextBlock Text="Повтор пароля"
                               Grid.Row="15"
                               VerticalAlignment="Center"/>

                    <PasswordBox x:Name="PassRepPB"
                                 Grid.Row="15"
                                 Grid.Column="1"
                                 FontSize="16"
                                 Padding="12"
                                 BorderBrush="#F26A1B"
                                 BorderThickness="2"/>

                    <Button x:Name="EnterBtn"
                            Grid.Row="17"
                            Grid.ColumnSpan="2"
                            Height="50"
                            FontSize="18"
                            FontWeight="Bold"
                            Background="#F26A1B"
                            Foreground="White"
                            BorderThickness="0"
                            Content="Создать аккаунт"
                            Click="EnterBtn_Click"/>

                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>