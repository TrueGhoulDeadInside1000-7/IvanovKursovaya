<Page x:Class="IvanovKursovaya.View.Pages.TicketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IvanovKursovaya.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TicketPage">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Background="White"
                CornerRadius="15"
                Padding="10">

            <ListView x:Name="InfoLV">

                <ListView.View>

                    <GridView>

                        <GridViewColumn Header="Дата"
                                        DisplayMemberBinding="{Binding DateTime, StringFormat=dd.MM.yyyy HH:mm}"
                                        Width="150"/>

                        <GridViewColumn Header="Тренировка"
                                        DisplayMemberBinding="{Binding Training.Title}"
                                        Width="220"/>

                        <GridViewColumn Header="Клиент"
                                        DisplayMemberBinding="{Binding Client.Name}"
                                        Width="150"/>

                        <GridViewColumn Header="Телефон"
                                        DisplayMemberBinding="{Binding Client.Phone}"
                                        Width="170"/>

                        <GridViewColumn Header="Инструктор"
                                        DisplayMemberBinding="{Binding DogHandler.Name}"
                                        Width="170"/>

                    </GridView>

                </ListView.View>

            </ListView>

        </Border>

        <Grid Grid.Row="1"
              Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="AddBtn"
                    Grid.Column="0"
                    Content="Добавить"
                    Height="45"
                    Margin="0,0,10,0"
                    Background="#F26A1B"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="16"
                    Click="AddBtn_Click"/>

            <Button x:Name="ChangeBtn"
                    Grid.Column="1"
                    Content="Изменить"
                    Height="45"
                    Margin="10,0,10,0"
                    Background="#222222"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="16"
                    Click="ChangeBtn_Click"/>

            <Button x:Name="DelBtn"
                    Grid.Column="2"
                    Content="Удалить"
                    Height="45"
                    Margin="10,0,0,0"
                    Background="#C62828"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="16"
                    Click="DelBtn_Click"/>

        </Grid>

    </Grid>
</Page>