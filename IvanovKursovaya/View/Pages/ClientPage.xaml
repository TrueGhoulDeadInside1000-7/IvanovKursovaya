<Page x:Class="IvanovKursovaya.View.Pages.ClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IvanovKursovaya.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ClientPage">

    <Grid Margin="15">

        <Border Background="White"
                CornerRadius="15"
                Padding="10">

            <ListView x:Name="InfoLV">

                <ListView.View>

                    <GridView>

                        <GridViewColumn Header="Имя"
                                        DisplayMemberBinding="{Binding Name}"
                                        Width="150"/>

                        <GridViewColumn Header="Фамилия"
                                        DisplayMemberBinding="{Binding Surename}"
                                        Width="150"/>

                        <GridViewColumn Header="Отчество"
                                        DisplayMemberBinding="{Binding Patronymic}"
                                        Width="170"/>

                        <GridViewColumn Header="Телефон"
                                        DisplayMemberBinding="{Binding Phone}"
                                        Width="180"/>

                        <GridViewColumn Header="Электронная почта"
                                        DisplayMemberBinding="{Binding Email}"
                                        Width="250"/>

                    </GridView>

                </ListView.View>

            </ListView>

        </Border>

    </Grid>
</Page>